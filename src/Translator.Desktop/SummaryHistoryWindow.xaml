<Window x:Class="Translator.Desktop.SummaryHistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Kayıt özeti" Width="760" Height="590" MinWidth="550" MinHeight="400" WindowStartupLocation="CenterOwner" Background="#F1F5FA">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <TextBlock x:Name="TitleText" FontSize="21" FontWeight="Bold" Foreground="#173653" Margin="0,0,0,12"/>
  <ComboBox Grid.Row="1" x:Name="SummaryBox" DisplayMemberPath="DisplayName" Height="32" SelectionChanged="Summary_SelectionChanged" Margin="0,0,0,12"/>
  <TextBox Grid.Row="2" x:Name="SummaryText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="14" FontSize="15" Background="White" BorderBrush="#DCE6F0"/>
 </Grid>
</Window>
