<Window x:Class="Translator.Desktop.HistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Kayıt geçmişi" Width="1040" Height="700" MinWidth="800" MinHeight="500" WindowStartupLocation="CenterOwner" Background="#F1F5FA">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="14,7"/><Setter Property="Background" Value="#DDEAF8"/><Setter Property="BorderBrush" Value="#B8D0E9"/><Setter Property="Foreground" Value="#163757"/></Style>
 </Window.Resources>
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <TextBlock Text="Kayıt geçmişi" FontSize="25" FontWeight="Bold" Foreground="#173653" Margin="0,0,0,15"/>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="360" MinWidth="220"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="320"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="15"><DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="Kayıtlar arasında ara" FontWeight="SemiBold" Margin="0,0,0,7"/>
    <TextBox DockPanel.Dock="Top" x:Name="SearchBox" Height="32" Margin="0,0,0,10" TextChanged="Search_Changed"/>
    <ListBox x:Name="RecordList" DisplayMemberPath="DisplayName" SelectionChanged="Record_SelectionChanged" PreviewMouseRightButtonDown="Record_RightClick" BorderBrush="#DCE6F0">
     <ListBox.ContextMenu><ContextMenu Opened="RecordMenu_Opening">
      <MenuItem Header="Yeniden adlandır" Tag="rename" Click="Rename_Click"/>
      <Separator/>
      <MenuItem Header="Kopyala" Tag="copy" Click="Copy_Click"/>
      <MenuItem Header="Yapıştır" Tag="paste" Click="Paste_Click"/>
      <Separator/>
      <MenuItem Header="Dışa aktar" Tag="export"><MenuItem Header="Kaydı" Tag="record" Click="Export_Click"/><MenuItem Header="Özeti" Tag="summary" Click="Export_Click"/><MenuItem Header="Kayıt ve özeti" Tag="both" Click="Export_Click"/></MenuItem>
      <MenuItem Header="Maliyeti yenile" Tag="cost" Click="RefreshCost_Click"/>
      <Separator/>
      <MenuItem Header="Sil" Tag="delete" Click="Delete_Click"/>
     </ContextMenu></ListBox.ContextMenu>
    </ListBox>
   </DockPanel></Border>
   <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#C8D9E9" ResizeBehavior="PreviousAndNext"/>
   <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="15"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="Metin içinde ara" FontWeight="SemiBold" Margin="0,0,0,7"/>
    <TextBox Grid.Row="1" x:Name="WithinSearchBox" Height="32" VerticalContentAlignment="Center" TextChanged="WithinSearch_Changed" Margin="0,0,0,12"/>
    <Grid Grid.Row="2" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="ShowTimeBox" Content="Zamanı göster" IsChecked="True" VerticalAlignment="Center" Checked="ShowTime_Changed" Unchecked="ShowTime_Changed"/><Button Grid.Column="1" x:Name="OpenSummaryButton" Content="Özeti aç" Click="OpenSummary_Click" IsEnabled="False"/></Grid>
    <TextBox Grid.Row="3" x:Name="DetailBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10" FontSize="14" BorderBrush="#DFE8F1"/>
   </Grid></Border>
  </Grid>
 </Grid>
</Window>
