<Window x:Class="Translator.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RecapVox" Icon="Assets/recapvox-logo.png" Width="1180" Height="780" MinWidth="920" MinHeight="620" Background="#F1F5FA">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="14,7"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="#DDEAF8"/><Setter Property="BorderBrush" Value="#B8D0E9"/><Setter Property="Foreground" Value="#163757"/></Style>
  <Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="Padding" Value="18,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="#1875C2"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#1875C2"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Height" Value="30"/></Style>
 </Window.Resources>
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#132B48" CornerRadius="12" Padding="20" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><StackPanel Orientation="Horizontal"><Image Source="Assets/recapvox-logo.png" Width="66" Height="66" Margin="0,0,14,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="RecapVox" FontSize="28" FontWeight="Bold" Foreground="White"/><TextBlock Text="Canlı çeviri · Ses kaydı · Yapay zekâ özetleri" Foreground="#D7E9FC" Margin="0,2,0,0"/></StackPanel></StackPanel><Grid Margin="0,7,12,0" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" MaxWidth="430" Margin="0,0,24,0"><TextBlock x:Name="LiveProviderText" Foreground="#7FDBEF" TextWrapping="Wrap"/><TextBlock x:Name="LiveBalanceText" Foreground="#D7E9FC" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" MaxWidth="350" Margin="0,0,16,0"><TextBlock x:Name="SummaryProviderText" Foreground="#B9CBDF" TextWrapping="Wrap"/><TextBlock x:Name="SummaryBalanceText" Foreground="#D7E9FC" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="2" Content="↻" ToolTip="Bakiyeleri yenile" Click="RefreshBalances_Click" Padding="4,0" VerticalAlignment="Center"/></Grid></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="HistoryButton" Content="Geçmiş" Click="History_Click" Padding="17,9" Margin="0,0,9,0"/><Button x:Name="SettingsButton" Content="Ayarlar" Click="Settings_Click" Padding="17,9"/></StackPanel>
  </Grid></Border>
  <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,14"><StackPanel>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="190"/><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" Margin="0,0,14,0"><TextBlock Text="Kaynak" Margin="0,0,0,5"/><ComboBox x:Name="SourceBox" SelectedIndex="0" SelectionChanged="SourceBox_SelectionChanged"><ComboBoxItem Content="Mikrofon"/><ComboBoxItem Content="Seçilen uygulama"/><ComboBoxItem Content="16 kHz WAV dosyası"/></ComboBox></StackPanel>
    <StackPanel Grid.Column="1" Margin="0,0,14,0"><TextBlock Text="Konuşma dili" Margin="0,0,0,5"/><ComboBox x:Name="SourceLanguageBox" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" MaxDropDownHeight="300" SelectionChanged="LanguageSelection_Changed" LostKeyboardFocus="LanguagePicker_LostFocus" ToolTip="Yazarak dil adı veya kodu arayın"/></StackPanel>
    <StackPanel Grid.Column="2" Margin="0,0,14,0"><TextBlock Text="Hedef dil" Margin="0,0,0,5"/><ComboBox x:Name="LanguageBox" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" MaxDropDownHeight="300" SelectionChanged="LanguageSelection_Changed" LostKeyboardFocus="LanguagePicker_LostFocus" ToolTip="Yazarak dil adı veya kodu arayın"/></StackPanel>
    <StackPanel Grid.Column="3"><TextBlock Text="Kayıt" Margin="0,0,0,5"/><WrapPanel VerticalAlignment="Center"><Button x:Name="StartButton" Content="Kaydı başlat" Style="{StaticResource PrimaryButton}" Click="StartButton_Click"/><Button x:Name="PauseButton" Content="⏸ Duraklat" Click="PauseButton_Click" IsEnabled="False"/><TextBlock x:Name="RecordTimerText" Text="● 00:00:00" Visibility="Collapsed" Foreground="#C12C39" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/></WrapPanel></StackPanel>
   </Grid>
   <WrapPanel x:Name="ApplicationPicker" Margin="0,10,0,0" Visibility="Collapsed"><TextBlock Text="Uygulama" VerticalAlignment="Center" Margin="0,0,7,0"/><ComboBox x:Name="ApplicationBox" Width="520" DisplayMemberPath="DisplayName" Margin="0,0,8,0"/><Button Content="Listeyi yenile" Click="RefreshApplications_Click"/><CheckBox x:Name="IncludeMicrophoneBox" Content="Mikrofonu da dahil et" VerticalAlignment="Center" Margin="8,0,0,0" Checked="IncludeMicrophone_Changed" Unchecked="IncludeMicrophone_Changed"/></WrapPanel>
   <TextBlock x:Name="SourceInfoText" Foreground="#315978" Margin="0,9,0,0" TextWrapping="Wrap"/>
   <WrapPanel Margin="0,12,0,0"><CheckBox x:Name="RecordAudioBox" Content="Sesi WAV olarak sakla" ToolTip="Ses, Ayarlar bölümündeki kayıt klasörüne kaydedilir" VerticalAlignment="Center" Margin="0,0,18,0"/><CheckBox x:Name="OverlayBox" Content="Yüzen altyazı" VerticalAlignment="Center" Margin="0,0,6,0" Checked="Overlay_Changed" Unchecked="Overlay_Changed"/><Button Content="⋯" ToolTip="Yüzen altyazı ayarları" Click="OverlaySettings_Click" Margin="0,0,18,0"/><Button Content="Oturumu dışa aktar" Click="Export_Click"/></WrapPanel>
  </StackPanel></Border>
  <TabControl Grid.Row="2" x:Name="MainTabs" Background="White">
   <TabItem Header="Canlı metin"><Border Background="White" Padding="16"><DockPanel>
    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10"><TextBlock Text="Konuşma ve çeviri" FontSize="17" FontWeight="SemiBold" Foreground="#183654" Margin="0,0,22,0"/><CheckBox x:Name="TimeBox" Content="Zamanı göster" VerticalAlignment="Center" Checked="Time_Changed" Unchecked="Time_Changed"/></WrapPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="TranscriptList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E2EAF2" BorderThickness="0,0,0,1" Padding="0,11"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="{Binding TimeWidth}"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="{Binding Timestamp}" Foreground="#2876AD" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Original}" TextWrapping="Wrap" FontSize="15" Foreground="#20324D"/><TextBlock Grid.Column="3" Text="{Binding Translation}" TextWrapping="Wrap" FontSize="15" Foreground="#174D66"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
   </DockPanel></Border></TabItem>
   <TabItem Header="Oturum özeti"><Border Background="White" Padding="16"><DockPanel>
    <StackPanel DockPanel.Dock="Top"><TextBlock Text="Konuşmanın özeti" FontSize="17" FontWeight="SemiBold" Foreground="#183654" Margin="0,0,0,10"/>
     <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="175"/><ColumnDefinition Width="145"/><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,12,0"><TextBlock Text="Tür" Margin="0,0,0,5"/><ComboBox x:Name="SummaryKindBox" SelectedIndex="0"><ComboBoxItem Content="Video / eğitim"/><ComboBoxItem Content="Toplantı"/></ComboBox></StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Uzunluk" Margin="0,0,0,5"/><ComboBox x:Name="SummaryLengthBox" SelectedIndex="0"><ComboBoxItem Content="Kısa"/><ComboBoxItem Content="Ayrıntılı"/></ComboBox></StackPanel>
      <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="Özet dili" Margin="0,0,0,5"/><ComboBox x:Name="SummaryLanguageBox" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" MaxDropDownHeight="300" SelectionChanged="LanguageSelection_Changed" LostKeyboardFocus="LanguagePicker_LostFocus" ToolTip="Yazarak dil adı veya kodu arayın"/></StackPanel>
      <StackPanel Grid.Column="3"><TextBlock Text=" " Margin="0,0,0,5"/><Button x:Name="SummarizeButton" Content="Özet oluştur" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Click="Summarize_Click"/></StackPanel>
     </Grid>
     <TextBlock x:Name="SummaryDateText" Text="Henüz özet yok" Foreground="#40739C" Margin="0,0,0,8"/><TextBlock Text="Özet isteği özgün konuşmayı seçili sağlayıcıya gönderir." Foreground="#60758C" TextWrapping="Wrap" Margin="0,0,0,10"/>
    </StackPanel><TextBox x:Name="SummaryText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="15" Padding="10" BorderBrush="#DFE8F1"/>
   </DockPanel></Border></TabItem>
   <TabItem Header="Geçmiş" Visibility="Collapsed"><Border Background="White" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <DockPanel Grid.Column="0"><TextBlock DockPanel.Dock="Top" Text="Kayıtlar arasında ara" FontWeight="SemiBold" Margin="0,0,0,7"/><TextBox DockPanel.Dock="Top" x:Name="HistorySearchBox" Height="31" Margin="0,0,0,10" TextChanged="HistorySearch_Changed"/><ListBox x:Name="HistoryList" DisplayMemberPath="DisplayName" SelectionChanged="HistorySelection_Changed" BorderBrush="#DCE6F0"/></DockPanel>
    <DockPanel Grid.Column="2"><TextBlock DockPanel.Dock="Top" Text="Seçili kayıtta ara" FontWeight="SemiBold" Margin="0,0,0,7"/><TextBox DockPanel.Dock="Top" x:Name="RecordSearchBox" Height="31" Margin="0,0,0,10" TextChanged="RecordSearch_Changed"/><TextBox x:Name="HistoryDetailText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="12" FontSize="14" BorderBrush="#DCE6F0"/></DockPanel>
   </Grid></Border></TabItem>
  </TabControl>
  <Border Grid.Row="3" Background="#DBEAF8" CornerRadius="8" Padding="11" Margin="0,12,0,0"><TextBlock x:Name="StatusText" Text="Hazır. Kaynağı seçip başlatabilirsiniz." TextWrapping="Wrap" Foreground="#1A476C"/></Border>
 </Grid>
</Window>
