<Window x:Class="Translator.Desktop.OverlaySettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Yüzen altyazı ayarları" Width="500" Height="350" MinWidth="450" MinHeight="320" WindowStartupLocation="CenterOwner" Background="#F1F5FA">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Grid.Row="0">
   <TextBlock Text="Yüzen altyazı" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>
   <Grid Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Göster" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="ContentBox" Height="31"><ComboBoxItem Content="İkisi" Tag="İkisi"/><ComboBoxItem Content="Orijinal" Tag="Orijinal"/><ComboBoxItem Content="Çeviri" Tag="Çeviri"/></ComboBox></Grid>
   <Grid Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Yerleşim" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="LayoutBox" Height="31"><ComboBoxItem Content="Alt alta" Tag="Alt alta"/><ComboBoxItem Content="Yan yana" Tag="Yan yana"/></ComboBox></Grid>
   <Grid Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Pencere genişliği" VerticalAlignment="Center"/><Slider Grid.Column="1" x:Name="WidthSlider" Minimum="420" Maximum="1400" TickFrequency="20" IsSnapToTickEnabled="True"/></Grid>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Yazı boyutu" VerticalAlignment="Center"/><Slider Grid.Column="1" x:Name="FontSlider" Minimum="14" Maximum="34" TickFrequency="1" IsSnapToTickEnabled="True"/></Grid>
  </StackPanel>
  <Button Grid.Row="1" Content="Kaydet ve uygula" Click="Save_Click" HorizontalAlignment="Right" Padding="18,9" Background="#1875C2" Foreground="White"/>
 </Grid>
</Window>
